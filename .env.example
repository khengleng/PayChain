# ---------------------------------------------------------------------------
# PayChain environment (M0). Copy to .env and fill in. NEVER commit real secrets.
# Every variable here is documented per §39/§47 of the master prompt.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
API_PORT=3000
LOG_LEVEL=info

# Database (Railway-managed PostgreSQL in prod; local docker in dev)
DATABASE_URL=postgresql://paychain:paychain@localhost:5432/paychain?schema=public

# Redis (cache, locks, rate limiting, idempotency coordination, queues)
REDIS_URL=redis://localhost:6379

# Auth — API client credentials (OAuth2 client-credentials) signing
JWT_SECRET=change-me-in-a-real-environment-min-32-chars
JWT_ACCESS_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Stellar (TESTNET ONLY in M0 — mainnet is gated, see README §0.2/§0.7)
# ---------------------------------------------------------------------------
STELLAR_NETWORK=testnet
STELLAR_RPC_PRIMARY_URL=https://soroban-testnet.stellar.org
STELLAR_RPC_SECONDARY_URL=
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org

# Platform funding / sponsorship account (testnet). Customers never hold XLM (§10).
# Dev-only encrypted key path per §11; HSM/MPC is a hard gate before any pilot (§0.6).
STELLAR_SPONSOR_PUBLIC_KEY=
STELLAR_SPONSOR_SECRET_KEY=

# Public on-chain identity, surfaced by GET /api/v1/stellar/health and /.well-known/stellar.toml.
# PUBLIC keys only — issuer/distribution SECRETS must live behind the external signer, never here.
STELLAR_ISSUER_PUBLIC_KEY=
STELLAR_DISTRIBUTION_PUBLIC_KEY=
STELLAR_FEE_ACCOUNT_PUBLIC_KEY=
STELLAR_ASSET_CODE=PAYC
# Only set 'true' AFTER the legal/regulatory/trustee backing model is formally approved — this makes
# stellar.toml assert fiat anchoring (is_asset_anchored / anchor_asset=USD).
STELLAR_ASSET_ANCHORED=false

# Key management (§11) — dev uses local encrypted keys; KMS/HSM/MPC are integration points.
KEY_MANAGEMENT_PROVIDER=local-dev
KEY_ENCRYPTION_KEY=change-me-32-byte-base64-key

# Platform domains / browser policy
# PayKH is a separate B2B client/tenant. Its backend integrates server-to-server and therefore is
# not a default browser origin for the PayChain API.
PAYCHAIN_PUBLIC_API_URL=https://api.paychain.cambobia.com
ADMIN_PORTAL_URL=https://paychain.cambobia.com
PAYCHAIN_DOCS_URL=https://docs.paychain.cambobia.com
PAYKH_CLIENT_URL=https://paykh.cambobia.com
API_ALLOWED_ORIGINS=https://paychain.cambobia.com,https://docs.paychain.cambobia.com,http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002

# Observability (§4) — optional in dev
OTEL_EXPORTER_OTLP_ENDPOINT=
