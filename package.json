{
  "name": "paychain",
  "version": "0.1.0",
  "private": true,
  "description": "PayChain — blockchain-backed digital value infrastructure (loyalty-first, stablecoin-ready)",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm -r --filter \"./apps/**\" build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "sdk:postprocess": "node scripts/postprocess-sdk-packages.mjs",
    "sdk:check": "node scripts/postprocess-sdk-packages.mjs --check",
    "db:generate": "pnpm --filter @paychain/database generate",
    "db:migrate": "pnpm --filter @paychain/database migrate:dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@next/eslint-plugin-next": "^16.2.10",
    "@types/node": "^20.11.0",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.9.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.2.0"
  },
  "pnpm": {
    "overrides": {
      "ioredis": "5.10.1"
    }
  }
}
