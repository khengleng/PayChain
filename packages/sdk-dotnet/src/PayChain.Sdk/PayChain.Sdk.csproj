<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo> <!-- setting GenerateAssemblyInfo to false causes this bug https://github.com/dotnet/project-system/issues/3934 -->
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>PayChain.Sdk</AssemblyName>
    <PackageId>PayChain.Sdk</PackageId>
    <OutputType>Library</OutputType>
    <Authors>PayChain</Authors>
    <Company>PayChain</Company>
    <AssemblyTitle>PayChain SDK</AssemblyTitle>
    <Description>Generated .NET SDK for the PayChain public API.</Description>
    <Copyright>Copyright PayChain</Copyright>
    <RootNamespace>PayChain.Sdk</RootNamespace>
    <Version>0.1.0</Version>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\PayChain.Sdk.xml</DocumentationFile>
    <PackageProjectUrl>https://developer.paychain.cambobia.com</PackageProjectUrl>
    <PackageLicenseFile>LICENSE-PAYCHAIN-SDK.txt</PackageLicenseFile>
    <PackageTags>paychain;api;sdk;openapi</PackageTags>
    <PackageReleaseNotes>Generated from the PayChain public OpenAPI contract.</PackageReleaseNotes>
    <Nullable>enable</Nullable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Condition="'$(TargetFramework)' == 'net8.0'" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Condition="'$(TargetFramework)' == 'net8.0'" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Condition="'$(TargetFramework)' == 'net8.0'" Version="8.0.20" />
    <PackageReference Include="Microsoft.Net.Http.Headers" Condition="'$(TargetFramework)' == 'net8.0'" Version="8.0.17" />
  </ItemGroup>

  <ItemGroup>
    <None Include="LICENSE-PAYCHAIN-SDK.txt" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
