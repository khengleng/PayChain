{
  "name": "@paychain/sdk",
  "version": "0.1.0",
  "description": "Hand-written TypeScript SDK for the PayChain public API.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "homepage": "https://developer.paychain.cambobia.com",
  "license": "UNLICENSED",
  "keywords": [
    "paychain",
    "sdk",
    "typescript",
    "api"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "test": "jest --passWithNoTests",
    "prepare": "pnpm run build"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "typescript": "^5.4.5",
    "@paychain/security": "workspace:*"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://packages.paychain.cambobia.com/npm/"
  }
}
