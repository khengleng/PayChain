// PayChain database schema — M0 foundation.
//
// Design rules honored here (README §0.4, §7, §16, §17, §18, §0.5):
//  - Every tenant-owned record carries tenantId + timestamps.
//  - The blockchain is authoritative for balances; BalanceReadModel is a rebuildable cache.
//  - Financial records (Transaction) are append-only in practice — never hard-deleted.
//  - IdempotencyRecord and OutboxEvent are first-class from day one.
//  - Migrations are additive; stablecoin-specific fields (§14) arrive as an additive
//    migration in M3, not by rewriting these tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- enums -----------------------------------------------------------------

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum ApiClientStatus {
  ACTIVE
  REVOKED
}

enum WalletOwnerType {
  CUSTOMER
  MERCHANT
  ORGANIZATION
  TREASURY
  CAMPAIGN
  SYSTEM
  REDEMPTION
  SETTLEMENT
}

enum WalletStatus {
  PENDING
  ACTIVE
  RESTRICTED
  FROZEN
  SUSPENDED
  CLOSING
  CLOSED
}

// Single canonical asset-type enum (§0.3, §13). Only LOYALTY_POINT is usable in M0;
// the remaining loyalty/non-stable types are reserved. Stablecoin lifecycle/controls
// (§14, §15) are layered in at M3 behind disabled feature flags.
enum AssetType {
  LOYALTY_POINT
  CASHBACK
  PROMOTIONAL_CREDIT
  MERCHANT_CREDIT
  GIFT_CARD
  VOUCHER
  COUPON
  MEMBERSHIP_CREDIT
  TICKET
  CARBON_CREDIT
  STABLE_VALUE_CREDIT
  FIAT_BACKED_STABLECOIN
  TOKENIZED_DEPOSIT
}

enum AssetStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  CLOSED
}

enum TransactionType {
  WALLET_CREATED
  TRUSTLINE_CREATED
  ASSET_ISSUED
  ASSET_TRANSFERRED
  ASSET_REDEEMED
  ASSET_BURNED
  ASSET_EXPIRED
  COMPENSATING_TRANSACTION
  WALLET_FROZEN
  WALLET_UNFROZEN
  TRANSACTION_FAILED
  TRANSACTION_RECONCILED
}

enum TransactionStatus {
  RECEIVED
  VALIDATING
  REJECTED
  QUEUED
  SIGNING
  SUBMITTED
  PENDING_CONFIRMATION
  CONFIRMED
  FAILED
  EXPIRED
  APPROVAL_REQUIRED
  APPROVED
  REVERSED_BY_COMPENSATION
  RECONCILIATION_REQUIRED
}

// Loyalty expiry policy on an asset (§21). Stellar assets never expire on-chain, so PayChain
// runs an off-chain scheduler that burns expired holdings.
enum ExpiryPolicy {
  NONE
  FIXED
  ROLLING
}

enum PointsLotStatus {
  ACTIVE
  EXPIRED
  CONSUMED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum WebhookEndpointStatus {
  ACTIVE
  DISABLED
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  DEAD
}

// Reconciliation exception categories (§31). M1 covers the loyalty-relevant subset; the
// stablecoin-specific categories (RESERVE_SHORTFALL, UNMATCHED_FIAT_PAYOUT, ...) are added
// with the stablecoin milestone (M3/M4) as an additive change.
enum ReconciliationCategory {
  MISSING_CONFIRMATION
  SUPPLY_MISMATCH
  DUPLICATE_TRANSACTION
  ORPHAN_BLOCKCHAIN_TRANSACTION
  BALANCE_DRIFT
  UNAUTHORIZED_MOVEMENT
  // Stablecoin-specific categories (§31), added with the stablecoin control plane (M3).
  RESERVE_SHORTFALL
  MISSING_MINT
  UNMATCHED_BURN
  UNMATCHED_FIAT_PAYOUT
  DUPLICATE_PAYOUT
  STALE_RESERVE_DATA
  UNAUTHORIZED_MINT
  LIMIT_BREACH
}

// Asset classification for the stablecoin control plane (§1, §0.3). Distinct from the
// on-chain asset TYPE; used to apply the right policies/gates. ALGORITHMIC_STABLECOIN and
// ASSET_BACKED_TOKEN are classification labels only — not implemented as products (§1).
enum AssetClassification {
  LOYALTY_POINT
  PROMOTIONAL_CREDIT
  MERCHANT_CREDIT
  STABLE_VALUE_CREDIT
  TOKENIZED_DEPOSIT
  FIAT_BACKED_STABLECOIN
  ALGORITHMIC_STABLECOIN
  ASSET_BACKED_TOKEN
}

// Stablecoin lifecycle (§15). A stablecoin cannot reach ACTIVE until all required approval
// gates pass (enforced by the lifecycle service, not the DB).
enum StablecoinLifecycle {
  DRAFT
  LEGAL_REVIEW
  COMPLIANCE_REVIEW
  TREASURY_REVIEW
  RESERVE_PENDING
  TECHNICAL_TESTING
  PILOT_APPROVED
  ACTIVE
  MINTING_SUSPENDED
  REDEMPTION_SUSPENDED
  FULLY_SUSPENDED
  WIND_DOWN
  CLOSED
}

// Maker-checker approval gates required before activation (§15, §19).
enum StablecoinApprovalGate {
  LEGAL
  COMPLIANCE
  TREASURY
  RESERVE
  TECHNICAL
  PILOT
}

// --- M4: stablecoin workflow enums --------------------------------------------

enum ReserveAccountStatus {
  ACTIVE
  SUSPENDED
}

// Mint saga states (§22). A mint NEVER advances to SIGNING/SUBMITTED before reserve
// confirmation and approval. A network failure after SUBMITTED stays SUBMITTED (recoverable),
// never silently FAILED and never re-minted.
enum MintStatus {
  REQUESTED
  RESERVE_PENDING
  RESERVE_CONFIRMED
  COMPLIANCE_REVIEW
  APPROVAL_REQUIRED
  APPROVED
  SIGNING
  SUBMITTED
  CONFIRMED
  RECONCILED
  REJECTED
  FAILED
}

// Redemption saga states (§25). Not COMPLETED until BOTH burn and fiat payout confirm.
enum RedemptionStatus {
  REQUESTED
  VALIDATING
  COMPLIANCE_REVIEW
  APPROVAL_REQUIRED
  APPROVED
  ESCROW_HELD
  BURN_PENDING
  BURN_CONFIRMED
  FIAT_PAYOUT_PENDING
  FIAT_PAYOUT_CONFIRMED
  COMPLETED
  REJECTED
  FAILED
  MANUAL_REVIEW
}

// Conversion saga states (§26). Loyalty→stablecoin as quote→burn→mint with compensation.
enum ConversionStatus {
  QUOTED
  CONFIRMED
  POINTS_BURN_PENDING
  POINTS_BURNED
  STABLECOIN_MINT_PENDING
  COMPLETED
  FAILED
  COMPENSATING
  COMPENSATED
}

enum TreasuryMovementStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  EXECUTED
  FAILED
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  HELD
  RESOLVED
  DISMISSED
}

// --- M6: production-readiness gates ------------------------------------------

enum ReadinessStatus {
  PENDING
  IN_PROGRESS
  PASSED
  FAILED
  BLOCKED
  WAIVED
}

enum EmergencyActionType {
  SUSPEND_MINTING
  SUSPEND_REDEMPTION
  SUSPEND_CONVERSION
  SUSPEND_TRANSFERS
  FREEZE_WALLET
  FREEZE_ASSET
  DISABLE_TENANT
  DISABLE_MAINNET_WRITES
  RESUME
}

enum ReconciliationStatus {
  OPEN
  RESOLVED
  IGNORED
}

// --- models ----------------------------------------------------------------

model Tenant {
  id        String       @id @default(uuid())
  name      String
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  apiClients   ApiClient[]
  wallets      Wallet[]
  assets       Asset[]
  transactions Transaction[]

  @@map("tenants")
}

model ApiClient {
  id               String          @id @default(uuid())
  tenantId         String
  name             String
  clientId         String          @unique
  clientSecretHash String
  scopes           String[]        @default([])
  status           ApiClientStatus @default(ACTIVE)
  createdBy        String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("api_clients")
}

model Wallet {
  id                 String          @id @default(uuid())
  tenantId           String
  ownerType          WalletOwnerType
  ownerReference     String
  stellarAccountId   String          @unique
  // Dev-only encrypted secret (§11). KMS/HSM/MPC replace this before any pilot (§0.6).
  stellarSecretEnc   String?
  status             WalletStatus    @default(PENDING)
  verificationStatus String          @default("UNVERIFIED")
  riskLevel          String          @default("LOW")
  createdBy          String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  lastActivityAt     DateTime?

  tenant       Tenant                 @relation(fields: [tenantId], references: [id])
  balances     BalanceReadModel[]
  sourceTxns   Transaction[]          @relation("SourceWallet")
  destTxns     Transaction[]          @relation("DestinationWallet")

  @@index([tenantId])
  @@index([tenantId, ownerReference])
  @@map("wallets")
}

model Asset {
  id                 String      @id @default(uuid())
  tenantId           String
  assetCode          String
  assetName          String
  assetType          AssetType   @default(LOYALTY_POINT)
  status             AssetStatus @default(DRAFT)
  issuerPublicKey    String
  // Dev-only encrypted issuer secret (§11). Issuer keys are isolated (§11) and must be
  // HSM/MPC-backed before leaving TECHNICAL_TESTING for any regulated asset (§0.6).
  issuerSecretEnc    String?
  distributionPublicKey String?
  decimals           Int         @default(7)
  transferability    Boolean     @default(true)
  redeemability      Boolean     @default(true)
  expiryPolicy       ExpiryPolicy @default(NONE)
  // Days until expiry for FIXED/ROLLING policies; null for NONE.
  expiryDays         Int?
  createdBy          String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  transactions Transaction[]
  pointsLots   PointsLot[]
  stablecoinConfig StablecoinConfig?

  @@unique([tenantId, assetCode, issuerPublicKey])
  @@index([tenantId])
  @@map("assets")
}

model Transaction {
  id                  String            @id @default(uuid())
  tenantId            String
  type                TransactionType
  status              TransactionStatus @default(RECEIVED)
  externalReference   String?
  idempotencyKey      String?
  blockchainHash      String?
  sourceWalletId      String?
  destinationWalletId String?
  assetId             String?
  amount              String?
  fee                 String?
  businessReason      String?
  // For COMPENSATING_TRANSACTION: the original transaction being economically reversed (§19).
  compensatesTransactionId String?
  correlationId       String
  // The maker (api client) that created this transaction — used for maker-checker on
  // approval-gated compensations (§19): the approver must differ from the maker.
  createdBy           String?
  approvedBy          String?
  failureCode         String?
  failureReason       String?
  createdAt           DateTime          @default(now())
  submittedAt         DateTime?
  confirmedAt         DateTime?

  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  asset             Asset?   @relation(fields: [assetId], references: [id])
  sourceWallet      Wallet?  @relation("SourceWallet", fields: [sourceWalletId], references: [id])
  destinationWallet Wallet?  @relation("DestinationWallet", fields: [destinationWalletId], references: [id])

  @@index([tenantId])
  @@index([tenantId, correlationId])
  @@index([blockchainHash])
  @@map("transactions")
}

// Rebuildable read model of balances (§16, §32). NEVER the source of truth — the chain
// is authoritative. `pnpm paychain rebuild:wallet-balances` reconstructs this from chain.
model BalanceReadModel {
  id       String @id @default(uuid())
  tenantId String
  walletId String
  assetCode String
  // Empty string for the native/no-issuer asset (XLM). Non-null so it can participate in
  // the compound unique key (Prisma disallows null in unique selectors).
  issuerPublicKey String   @default("")
  balance         String   @default("0")
  source          String   @default("stellar")
  ledger          Int?
  updatedAt       DateTime @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@unique([walletId, assetCode, issuerPublicKey])
  @@index([tenantId])
  @@map("balance_read_models")
}

// Tenant-scoped, persistent idempotency (§18). Survives restarts. Same key+payload
// returns the stored response; same key+different payload is a conflict.
model IdempotencyRecord {
  id             String   @id @default(uuid())
  tenantId       String
  key            String
  requestHash    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@unique([tenantId, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

// Transactional outbox (§0.5). Side effects are written here in the same DB transaction
// as the state change, then dispatched by the worker — no fire-and-forget inside a txn.
model OutboxEvent {
  id            String       @id @default(uuid())
  tenantId      String
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  status        OutboxStatus @default(PENDING)
  correlationId String
  attempts      Int          @default(0)
  createdAt     DateTime     @default(now())
  processedAt   DateTime?

  @@index([status, createdAt])
  @@index([tenantId])
  @@map("outbox_events")
}

model AuditLog {
  id            String   @id @default(uuid())
  tenantId      String?
  actor         String
  action        String
  resourceType  String
  resourceId    String?
  correlationId String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([tenantId])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

// A lot of loyalty points earned/issued at a point in time, used by the off-chain expiry
// engine (§21). expiresAt is computed from the asset's expiry policy when the lot is
// created. The expiry job burns the still-held remaining amount once expiresAt passes.
model PointsLot {
  id        String          @id @default(uuid())
  tenantId  String
  walletId  String
  assetId   String
  amount    String
  remaining String
  status    PointsLotStatus @default(ACTIVE)
  earnedAt  DateTime        @default(now())
  expiresAt DateTime?
  createdAt DateTime        @default(now())

  asset Asset @relation(fields: [assetId], references: [id])

  @@index([tenantId])
  @@index([status, expiresAt])
  @@index([walletId, assetId])
  @@map("points_lots")
}

// Stablecoin control-plane configuration (§14), 1:1 with an Asset. Populated only for
// stable-value/stablecoin assets. Kept separate from the loyalty Asset so the base asset
// stays lean and the migration is additive (§0.4). No live minting happens in M3.
model StablecoinConfig {
  id                          String              @id @default(uuid())
  tenantId                    String
  assetId                     String              @unique
  classification              AssetClassification
  referenceCurrency           String
  lifecycleState              StablecoinLifecycle @default(DRAFT)
  reserveModel                String?
  reserveAccountReference     String?
  reserveRatioTarget          String              @default("1.0")
  redemptionEnabled           Boolean             @default(false)
  mintingModel                String?
  burningModel                String?
  issuerLegalEntity           String?
  regulatedStatus             String?
  jurisdiction                String?
  licenseReference            String?
  attestationRequired         Boolean             @default(true)
  attestationFrequency        String?
  proofOfReserveEnabled       Boolean             @default(false)
  minimumRedemptionAmount     String?
  maximumRedemptionAmount     String?
  redemptionFee               String?
  mintFee                     String?
  transferFee                 String?
  dailyMintLimit              String?
  dailyRedeemLimit            String?
  perWalletHoldingLimit       String?
  travelRuleRequired          Boolean             @default(false)
  kycLevelRequired            String              @default("NONE")
  amlScreeningRequired        Boolean             @default(true)
  sanctionsScreeningRequired  Boolean             @default(true)
  featureFlag                 String?
  activationStatus            String              @default("INACTIVE")
  createdBy                   String?
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt

  asset     Asset                @relation(fields: [assetId], references: [id])
  approvals StablecoinApproval[]

  @@index([tenantId])
  @@map("stablecoin_configs")
}

// Records a maker-checker approval for a lifecycle gate (§15, §19). Unique per (config, gate).
model StablecoinApproval {
  id                 String                 @id @default(uuid())
  stablecoinConfigId String
  gate               StablecoinApprovalGate
  approvedBy         String
  note               String?
  approvedAt         DateTime               @default(now())

  config StablecoinConfig @relation(fields: [stablecoinConfigId], references: [id])

  @@unique([stablecoinConfigId, gate])
  @@map("stablecoin_approvals")
}

// Feature flags (§36). tenantId "GLOBAL" holds platform defaults; a real tenant id holds an
// override. All stablecoin.* production flags default to OFF.
model FeatureFlag {
  id        String   @id @default(uuid())
  tenantId  String   @default("GLOBAL")
  key       String
  enabled   Boolean  @default(false)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
  @@map("feature_flags")
}

// Wallet-level stablecoin controls (§27). A wallet is NOT stablecoin-eligible just because
// it can hold loyalty points. assetId "ALL" applies wallet-wide; a specific id scopes to one.
model WalletStablecoinPolicy {
  id                 String   @id @default(uuid())
  tenantId           String
  walletId           String
  assetId            String   @default("ALL")
  maxBalance         String?
  maxDailyReceive    String?
  maxDailySend       String?
  maxMonthlyVolume   String?
  maxTxPerDay        Int?
  allowedCountries   String[] @default([])
  kycLevel           String   @default("NONE")
  riskRating         String   @default("LOW")
  sanctionsStatus    String   @default("CLEAR")
  eddRequired        Boolean  @default(false)
  transferRestricted Boolean  @default(false)
  frozen             Boolean  @default(false)
  redemptionEligible Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([walletId, assetId])
  @@index([tenantId])
  @@map("wallet_stablecoin_policies")
}

// Point-in-time reserve figures for proof-of-reserve (§5, §24). Data model only in M3.
model ReserveSnapshot {
  id                         String   @id @default(uuid())
  tenantId                   String
  assetId                    String
  reserveBalance             String
  outstandingSupply          String
  reserveRatio               String
  unredeemedLiability        String?
  pendingMintLiability       String?
  pendingRedemptionLiability String?
  source                     String   @default("manual")
  snapshotHash               String?
  takenAt                    DateTime @default(now())

  @@index([tenantId, assetId])
  @@map("reserve_snapshots")
}

// Proof-of-reserve attestation metadata (§24). Only public metadata + a document hash are
// stored; confidential banking documents are never put on-chain, and the on-chain anchor
// (if any) references only the hash — it proves existence, not solvency (§0.6).
model Attestation {
  id               String    @id @default(uuid())
  tenantId         String
  assetId          String
  identifier       String
  version          Int       @default(1)
  reserveRatio     String?
  auditorReference String?
  documentHash     String?
  status           String    @default("DRAFT")
  effectiveAt      DateTime?
  expiresAt        DateTime?
  onChainAnchorTx  String?
  createdAt        DateTime  @default(now())

  @@index([tenantId, assetId])
  @@map("attestations")
}

// --- M4: stablecoin workflow models -------------------------------------------

// A registered reserve account (§23). Stores only references (bank/custodian) — NEVER
// online banking credentials. Balances are recorded via reserve movements/snapshots.
model ReserveAccount {
  id                 String               @id @default(uuid())
  tenantId           String
  assetId            String
  label              String
  custodianReference String?
  bankReference      String?
  balance            String               @default("0")
  status             ReserveAccountStatus @default(ACTIVE)
  createdBy          String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  movements ReserveMovement[]

  @@index([tenantId, assetId])
  @@map("reserve_accounts")
}

// An approved change to a reserve balance (§23). Movements are maker-checker gated in the
// service; this table is the audit-friendly ledger of reserve changes.
model ReserveMovement {
  id               String   @id @default(uuid())
  tenantId         String
  reserveAccountId String
  direction        String // CREDIT | DEBIT
  amount           String
  reference        String?
  createdBy        String?
  approvedBy       String?
  createdAt        DateTime @default(now())

  account ReserveAccount @relation(fields: [reserveAccountId], references: [id])

  @@index([tenantId])
  @@map("reserve_movements")
}

// Mint request saga (§22, §0.5). Persisted state machine; each step is idempotent and
// resumable. references funding/reserve/approval/compliance/hash/idempotency/correlation.
model StablecoinMintRequest {
  id                   String     @id @default(uuid())
  tenantId             String
  assetId              String
  destinationWalletId  String
  amount               String
  status               MintStatus @default(REQUESTED)
  fundingReference     String?
  reserveConfirmed     Boolean    @default(false)
  complianceResult     String?
  approvedBy           String?
  requestedBy          String
  idempotencyKey       String?
  blockchainHash       String?
  reconciliationStatus String?
  failureReason        String?
  correlationId        String
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([tenantId, assetId])
  @@index([status])
  @@map("stablecoin_mint_requests")
}

// Redemption saga (§25, §0.8). Default sequencing: escrow hold → payout authorization →
// burn on payout confirmation. COMPLETED only when both burn and payout are confirmed.
model StablecoinRedemption {
  id                  String           @id @default(uuid())
  tenantId            String
  assetId             String
  walletId            String
  amount              String
  status              RedemptionStatus @default(REQUESTED)
  kycValidated        Boolean          @default(false)
  amlResult           String?
  sanctionsResult     String?
  bankAccountReference String?
  approvedBy          String?
  requestedBy         String
  burnHash            String?
  payoutReference     String?
  failureReason       String?
  correlationId       String
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([tenantId, assetId])
  @@index([status])
  @@map("stablecoin_redemptions")
}

// Loyalty→stablecoin conversion saga (§26). Never a simple balance update: quote → burn
// points → mint stablecoin, with compensation if a leg fails.
model StablecoinConversion {
  id               String           @id @default(uuid())
  tenantId         String
  fromAssetId      String
  toAssetId        String
  walletId         String
  pointsAmount     String
  stablecoinAmount String
  rate             String
  spread           String           @default("0")
  fee              String           @default("0")
  status           ConversionStatus @default(QUOTED)
  quoteExpiresAt   DateTime
  pointsBurnHash   String?
  mintRequestId    String?
  failureReason    String?
  correlationId    String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([tenantId])
  @@index([status])
  @@map("stablecoin_conversions")
}

// Treasury movement with maker-checker (§30). The same user may not create AND approve.
model TreasuryMovement {
  id            String                 @id @default(uuid())
  tenantId      String
  assetId       String?
  fromAccount   String
  toAccount     String
  amount        String
  purpose       String
  status        TreasuryMovementStatus @default(PENDING_APPROVAL)
  createdBy     String
  approvedBy    String?
  executedAt    DateTime?
  correlationId String
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([tenantId])
  @@index([status])
  @@map("treasury_movements")
}

// Transaction-monitoring alert (§29). CRITICAL may trigger an automated hold; every action
// (including holds) records a reason — never a silent block.
model MonitoringAlert {
  id               String        @id @default(uuid())
  tenantId         String
  ruleKey          String
  severity         AlertSeverity
  status           AlertStatus   @default(OPEN)
  subjectType      String
  subjectReference String
  reason           String
  holdApplied      Boolean       @default(false)
  detail           Json?
  correlationId    String?
  createdAt        DateTime      @default(now())
  resolvedAt       DateTime?

  @@index([tenantId])
  @@index([severity, status])
  @@map("monitoring_alerts")
}

// A production-readiness gate (§43, §35). Platform-level (not tenant-scoped). Production /
// mainnet activation stays blocked until every MANDATORY gate is PASSED (or WAIVED with a
// recorded reason). Evidence-based — never an arbitrary confidence number.
model ReadinessGate {
  id         String          @id @default(uuid())
  key        String          @unique
  category   String
  title      String
  mandatory  Boolean         @default(true)
  status     ReadinessStatus @default(PENDING)
  evidence   String?
  owner      String?
  verifiedBy String?
  verifiedAt DateTime?
  notes      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([category])
  @@map("readiness_gates")
}

// Audit-friendly record of an emergency control action (§37). Every emergency action is
// recorded with a reason — never a silent block.
model EmergencyControlEvent {
  id        String              @id @default(uuid())
  tenantId  String?
  action    EmergencyActionType
  scope     String?
  reason    String
  actor     String
  createdAt DateTime            @default(now())

  @@index([action])
  @@map("emergency_control_events")
}

// Outbound webhook subscription (§35). The signing secret is stored encrypted (§41).
model WebhookEndpoint {
  id        String                @id @default(uuid())
  tenantId  String
  url       String
  secretEnc String
  events    String[]              @default([])
  status    WebhookEndpointStatus @default(ACTIVE)
  createdBy String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  deliveries WebhookDelivery[]

  @@index([tenantId])
  @@map("webhook_endpoints")
}

// One delivery attempt-set per (endpoint, event). The unique (endpointId, eventId) key
// enforces at-most-once delivery per event — the basis of duplicate-webhook protection (§35).
model WebhookDelivery {
  id            String                @id @default(uuid())
  tenantId      String
  endpointId    String
  eventType     String
  eventId       String
  payload       Json
  status        WebhookDeliveryStatus @default(PENDING)
  attempts      Int                   @default(0)
  lastError     String?
  correlationId String?
  createdAt     DateTime              @default(now())
  deliveredAt   DateTime?

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id])

  @@unique([endpointId, eventId])
  @@index([tenantId])
  @@index([status, createdAt])
  @@map("webhook_deliveries")
}

// Reconciliation exception queue (§31). Discrepancies are recorded, never silently
// overwritten. A human/operator resolves or ignores each one.
model ReconciliationException {
  id            String                 @id @default(uuid())
  tenantId      String
  category      ReconciliationCategory
  status        ReconciliationStatus   @default(OPEN)
  transactionId String?
  blockchainHash String?
  detail        Json
  correlationId String?
  createdAt     DateTime               @default(now())
  resolvedAt    DateTime?
  resolvedBy    String?

  @@index([tenantId])
  @@index([status, category])
  @@map("reconciliation_exceptions")
}
