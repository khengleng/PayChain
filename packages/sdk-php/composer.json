{
    "name": "paychain/sdk-php",
    "version": "0.1.0",
    "description": "Generated PHP SDK for the PayChain public API.",
    "type": "library",
    "keywords": [
        "paychain",
        "sdk",
        "php",
        "openapi",
        "api"
    ],
    "homepage": "https://developer.paychain.cambobia.com",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "PayChain",
            "homepage": "https://developer.paychain.cambobia.com"
        }
    ],
    "support": {
        "issues": "https://github.com/khengleng/PayChain/issues",
        "source": "https://github.com/khengleng/PayChain"
    },
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.4.5",
        "guzzlehttp/psr7": "^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.5",
        "overtrue/phplint": "^9.0",
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "PayChainSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PayChainSdk\\Test\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@phplint"
        ],
        "phplint": "phplint"
    }
}
